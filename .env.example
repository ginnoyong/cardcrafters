# Postgres connection string (used by Prisma).
DATABASE_URL="postgresql://cardcrafters:cardcrafters@localhost:5432/cardcrafters"

# Redis connection string (used by ioredis/BullMQ).
REDIS_URL="redis://localhost:6379"

# OpenRouter API key for AI calls (image generation + text tasks).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-REPLACE_ME"

# OpenRouter API base URL.
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# AI execution mode: "auto" | "live" | "mock".
AI_MODE="auto"

# Hard spending cap per game, in USD (default 25 when unset).
AI_BUDGET_PER_GAME_USD="50"

# Secret used to sign session tokens. CHANGE THIS in production.
SESSION_SECRET="REPLACE_ME_WITH_A_LONG_RANDOM_STRING"

# HTTP port the app server listens on.
PORT="3000"