# Postgres connection string (used by Prisma).
# Dev (docker-compose.yml publishes 5432): localhost. Prod (docker-compose.prod.yml):
# the compose file overrides this with the container-internal hostname `postgres`.
DATABASE_URL="postgresql://cardcrafters:cardcrafters@localhost:5432/cardcrafters"

# Redis connection string (used by ioredis/BullMQ).
# Prod: the compose file overrides this with the container-internal hostname `redis`.
REDIS_URL="redis://localhost:6379"

# OpenRouter API key for AI calls (image generation + text tasks).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-REPLACE_ME"

# OpenRouter API base URL.
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# AI execution mode: "auto" | "live" | "mock".
AI_MODE="auto"

# Hard spending cap per game, in USD (default 25 when unset).
AI_BUDGET_PER_GAME_USD="50"

# Secret used to sign session tokens. CHANGE THIS in production.
# NOTE: currently unused by the app code (no session signing yet); kept here
# so it is ready when session auth lands.
SESSION_SECRET="REPLACE_ME_WITH_A_LONG_RANDOM_STRING"

# HTTP port the app server listens on.
# NOTE: NODE_ENV and PORT are set explicitly by docker-compose.prod.yml.
PORT="3000"

# AI request concurrency caps (see apps/web/src/server/ai/openrouter-provider.ts).
# Overall in-flight OpenRouter requests (default 6).
AI_MAX_CONCURRENT_REQUESTS="6"
# In-flight image-generation requests (default 3; clamped to ≤ the overall cap).
AI_MAX_CONCURRENT_IMAGES="3"

# Image-generation worker concurrency for the BullMQ queue (default 4).
CC_IMAGE_CONCURRENCY="4"

# Public domain for TLS mode (docker-compose.prod.yml + config/Caddyfile),
# e.g. "cards.example.com". Requires a DNS A record pointing at the server
# and inbound ports 80/443 open. Leave empty for LAN mode (plain :3000).
CC_DOMAIN=""
